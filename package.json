{
  "name": "image-to-palette",
  "description": "Website ini adalah website untuk mengenerate warna/palet dari gambar yang di inputkan.",
  "version": "1.0.0",
  "main": "tailwind.config.js",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.23",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "build:js": "node scripts/build-js.js",
    "build:css": "npx tailwindcss -i ./src/css/style.css -o ./dist/css/style.css --minify",
    "dev": "npm run build:js && npx tailwindcss -i ./src/css/style.css -o ./dist/css/style.css --watch",
    "watch": "npm run dev",
    "minify": "npm run build:js && npm run build:css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bagussatoto/image-get-palette.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bagussatoto/image-get-palette/issues"
  },
  "homepage": "https://github.com/bagussatoto/image-get-palette#readme"
}
